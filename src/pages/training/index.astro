---
import Page from "../../layouts/page.astro";
import {
    AcademicCapIcon,
    ArrowTopRightOnSquareIcon,
    BeakerIcon,
    BookOpenIcon,
    CalendarIcon,
    CircleStackIcon,
    MagnifyingGlassIcon,
    WrenchScrewdriverIcon,
} from "@heroicons/react/24/outline";
import Unavailable from "../../components/tess-unavailable.astro";
import { upcomingEvents, pastEvents, materials, eventLink, materialLink, eventDates, eventPlace } from "../../lib/tess";

// Fetched at build time rather than from the browser: TESS rejects a request
// that does not ask for JSON, and the error page it returns carries no CORS
// headers. See src/lib/tess.ts.
const [upcoming, past, trainingMaterials] = await Promise.all([
    upcomingEvents(5),
    pastEvents(10),
    materials(10),
]);
---

<Page variant="wide" seo={{
    title: "Training",
    description: "Open-access bioinformatics training from ELIXIR Norway — introductory workshops to advanced courses in genomics, data management, and computational biology.",
}}>

    <!-- Hero -->
    <div class="max-w-3xl">
        <p class="text-sm font-semibold text-accent tracking-wide uppercase">Training</p>
        <h1 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-brand-primary dark:text-white leading-[1.15]">
            Bioinformatics training for&nbsp;every&nbsp;level
        </h1>
        <p class="mt-6 text-base sm:text-lg leading-relaxed text-brand-grey dark:text-gray-300 max-w-2xl">
            From introductory workshops to advanced domain-specific courses, ELIXIR Norway
            provides open-access training to support life science researchers across Norway and internationally.
        </p>
    </div>

    <!-- Training types grid -->
    <section class="mt-20">
        <h2 class="text-2xl font-bold text-brand-primary dark:text-white">Types of training</h2>
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">

            <!-- RDM -->
            <div class="rounded-xl border border-gray-200/60 dark:border-gray-700/30 bg-white dark:bg-white/[0.03] p-6">
                <div class="flex items-center gap-3 mb-3">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-100 dark:bg-blue-900/20">
                        <CircleStackIcon className="h-5 w-5 text-blue-600 dark:text-blue-400" aria-hidden="true" />
                    </div>
                    <h3 class="text-base font-semibold text-brand-primary dark:text-white">Research Data Management</h3>
                </div>
                <p class="text-sm leading-relaxed text-brand-grey dark:text-gray-400">
                    General RDM courses covering data collection, metadata management, sensitive data regulations, and FAIR data handling best practices.
                </p>
            </div>

            <!-- Tool-specific -->
            <div class="rounded-xl border border-gray-200/60 dark:border-gray-700/30 bg-white dark:bg-white/[0.03] p-6">
                <div class="flex items-center gap-3 mb-3">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10">
                        <WrenchScrewdriverIcon className="h-5 w-5 text-accent" aria-hidden="true" />
                    </div>
                    <h3 class="text-base font-semibold text-brand-primary dark:text-white">Tool-Specific Courses</h3>
                </div>
                <p class="text-sm leading-relaxed text-brand-grey dark:text-gray-400">
                    Hands-on training for <a href="https://nels.elixir.no" class="text-accent hover:underline">NeLS</a>, <a href="https://galaxyproject.org/use/usegalaxy-no/" class="text-accent hover:underline">UseGalaxy</a>, <a href="https://norway.dsw.elixir-europe.org/wizard/" class="text-accent hover:underline">Data Stewardship Wizard</a>, <a href="https://ega.elixir.no/" class="text-accent hover:underline">FEGA-Norway</a>, and other tools in the ELIXIR ecosystem.
                </p>
            </div>

            <!-- Domain-specific -->
            <div class="rounded-xl border border-gray-200/60 dark:border-gray-700/30 bg-white dark:bg-white/[0.03] p-6">
                <div class="flex items-center gap-3 mb-3">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-green-100 dark:bg-green-900/20">
                        <BeakerIcon className="h-5 w-5 text-green-600 dark:text-green-400" aria-hidden="true" />
                    </div>
                    <h3 class="text-base font-semibold text-brand-primary dark:text-white">Domain-Specific Courses</h3>
                </div>
                <p class="text-sm leading-relaxed text-brand-grey dark:text-gray-400">
                    Specialised training in single-cell sequencing, microbiome analysis, biodiversity studies, genome assembly, and more.
                </p>
            </div>

            <!-- Train-the-Trainer -->
            <div class="rounded-xl border border-gray-200/60 dark:border-gray-700/30 bg-white dark:bg-white/[0.03] p-6">
                <div class="flex items-center gap-3 mb-3">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-purple-100 dark:bg-purple-900/20">
                        <AcademicCapIcon className="h-5 w-5 text-purple-600 dark:text-purple-400" aria-hidden="true" />
                    </div>
                    <h3 class="text-base font-semibold text-brand-primary dark:text-white">Train-the-Trainer</h3>
                </div>
                <p class="text-sm leading-relaxed text-brand-grey dark:text-gray-400">
                    Part of the <a href="https://elixir-europe.org/platforms/training/train-the-trainer" class="text-accent hover:underline">ELIXIR-GOBLET TtT programme</a> — learn teaching techniques for productive learner engagement and effective course design.
                </p>
            </div>

        </div>
    </section>

    <!-- Resources -->
    <section class="mt-20">
        <h2 class="text-2xl font-bold text-brand-primary dark:text-white">Find courses and materials</h2>
        <p class="mt-3 text-sm leading-relaxed text-brand-grey dark:text-gray-400 max-w-2xl">
            Browse our catalogue of available courses, categorised by topic and proficiency level.
            All training materials are open-access.
        </p>
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
            <a href="https://tess.elixir-europe.org/" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 rounded-xl border border-gray-200/60 dark:border-gray-700/30 bg-white dark:bg-white/[0.03] p-4 transition-all duration-200 hover:border-accent/30 hover:shadow-md">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-primary/5 dark:bg-brand-primary/10">
                    <MagnifyingGlassIcon className="h-5 w-5 text-accent" aria-hidden="true" />
                </div>
                <div class="min-w-0">
                    <p class="text-sm font-semibold text-brand-primary dark:text-white group-hover:text-accent transition-colors">ELIXIR TeSS</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Course catalogue</p>
                </div>
                <ArrowTopRightOnSquareIcon className="ml-auto h-4 w-4 shrink-0 text-gray-500 dark:text-gray-400 group-hover:text-accent transition-colors" aria-hidden="true" />
            </a>
            <a href="https://github.com/ELIXIR-Norway-Training" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 rounded-xl border border-gray-200/60 dark:border-gray-700/30 bg-white dark:bg-white/[0.03] p-4 transition-all duration-200 hover:border-accent/30 hover:shadow-md">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-primary/5 dark:bg-brand-primary/10">
                    <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                    </svg>
                </div>
                <div class="min-w-0">
                    <p class="text-sm font-semibold text-brand-primary dark:text-white group-hover:text-accent transition-colors">GitHub</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Training materials</p>
                </div>
                <ArrowTopRightOnSquareIcon className="ml-auto h-4 w-4 shrink-0 text-gray-500 dark:text-gray-400 group-hover:text-accent transition-colors" aria-hidden="true" />
            </a>
            <a href="https://zenodo.org/communities/elixir-no/records?q=&f=resource_type%3Alesson&f=resource_type%3Apresentation&l=list&p=1&s=10&sort=newest" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 rounded-xl border border-gray-200/60 dark:border-gray-700/30 bg-white dark:bg-white/[0.03] p-4 transition-all duration-200 hover:border-accent/30 hover:shadow-md">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-primary/5 dark:bg-brand-primary/10">
                    <BookOpenIcon className="h-5 w-5 text-accent" aria-hidden="true" />
                </div>
                <div class="min-w-0">
                    <p class="text-sm font-semibold text-brand-primary dark:text-white group-hover:text-accent transition-colors">Zenodo</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Archived materials</p>
                </div>
                <ArrowTopRightOnSquareIcon className="ml-auto h-4 w-4 shrink-0 text-gray-500 dark:text-gray-400 group-hover:text-accent transition-colors" aria-hidden="true" />
            </a>
        </div>
    </section>

    <!-- Upcoming training -->
    <section class="mt-20" id="upcoming-events">
        <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
            <h2 class="text-2xl font-bold text-brand-primary dark:text-white">Upcoming training</h2>
            <a href="https://tess.elixir-europe.org/events?country[]=Norway"
               target="_blank" rel="noopener noreferrer"
               class="text-sm font-medium text-accent hover:underline rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
                Browse all on TeSS
            </a>
        </div>
        <div class="rounded-xl border border-gray-200/60 dark:border-gray-700/30 bg-white dark:bg-white/[0.03] p-6">
            {upcoming.items.length > 0 ? (
                <ul class="divide-y divide-gray-200/60 dark:divide-gray-700/30">
                    {upcoming.items.map((event) => (
                        <li class="py-4 first:pt-0 last:pb-0">
                            <a href={eventLink(event)} target="_blank" rel="noopener noreferrer"
                               class="group -m-2 block rounded-lg p-2 transition-colors hover:bg-gray-50 dark:hover:bg-white/[0.04] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
                                <p class="font-semibold text-brand-primary dark:text-white transition-colors group-hover:text-accent">{event.title}</p>
                                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
                                    {[eventDates(event), eventPlace(event)].filter(Boolean).join(" \u00b7 ")}
                                </p>
                            </a>
                        </li>
                    ))}
                </ul>
            ) : upcoming.reachable ? (
                <p class="flex items-center justify-center py-10 text-sm text-gray-500 dark:text-gray-400">
                    <CalendarIcon className="mr-2 h-5 w-5" aria-hidden="true" />
                    No upcoming training events at the moment.
                </p>
            ) : (
                <Unavailable href="https://tess.elixir-europe.org/events?country[]=Norway" />
            )}
        </div>
    </section>

    <!-- Training material -->
    <section class="mt-16" id="training-material">
        <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
            <h2 class="text-2xl font-bold text-brand-primary dark:text-white">Training materials</h2>
            <a href="https://tess.elixir-europe.org/materials?node[]=Norway"
               target="_blank" rel="noopener noreferrer"
               class="text-sm font-medium text-accent hover:underline rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
                Browse all on TeSS
            </a>
        </div>
        <div class="rounded-xl border border-gray-200/60 dark:border-gray-700/30 bg-white dark:bg-white/[0.03] p-6">
            {trainingMaterials.items.length > 0 ? (
                <Fragment>
                    <label for="material-filter" class="sr-only">Filter training materials</label>
                    <div class="relative">
                        <MagnifyingGlassIcon className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" aria-hidden="true" />
                        <input id="material-filter" type="search" autocomplete="off"
                               placeholder="Filter materials by title"
                               class="w-full rounded-lg border border-gray-200/60 dark:border-gray-700/30 bg-white dark:bg-white/[0.03] py-2 pl-9 pr-3 text-sm text-brand-grey dark:text-gray-200 placeholder:text-gray-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" />
                    </div>
                    <ul id="material-list" class="mt-4 divide-y divide-gray-200/60 dark:divide-gray-700/30">
                        {trainingMaterials.items.map((material) => (
                            <li class="py-4 first:pt-0 last:pb-0" data-title={material.title.toLowerCase()}>
                                <a href={materialLink(material)} target="_blank" rel="noopener noreferrer"
                                   class="group -m-2 block rounded-lg p-2 transition-colors hover:bg-gray-50 dark:hover:bg-white/[0.04] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
                                    <p class="font-semibold text-brand-primary dark:text-white transition-colors group-hover:text-accent">{material.title}</p>
                                    {material.description && (
                                        <p class="mt-1 line-clamp-2 text-sm text-gray-600 dark:text-gray-400">{material.description}</p>
                                    )}
                                </a>
                            </li>
                        ))}
                    </ul>
                    <p id="material-empty" hidden aria-live="polite"
                       class="py-10 text-center text-sm text-gray-500 dark:text-gray-400">
                        No materials match that filter.
                    </p>
                </Fragment>
            ) : trainingMaterials.reachable ? (
                <p class="flex items-center justify-center py-10 text-sm text-gray-500 dark:text-gray-400">
                    <BookOpenIcon className="mr-2 h-5 w-5" aria-hidden="true" />
                    No training materials listed at the moment.
                </p>
            ) : (
                <Unavailable href="https://tess.elixir-europe.org/materials?node[]=Norway" />
            )}
        </div>
    </section>

    <!-- Past events -->
    <section class="mt-16" id="past-events">
        <h2 class="text-2xl font-bold text-brand-primary dark:text-white mb-6">Past training events</h2>
        <div class="rounded-xl border border-gray-200/60 dark:border-gray-700/30 bg-white dark:bg-white/[0.03] p-6">
            {past.items.length > 0 ? (
                <ul class="divide-y divide-gray-200/60 dark:divide-gray-700/30">
                    {past.items.map((event) => (
                        <li class="py-4 first:pt-0 last:pb-0">
                            <a href={eventLink(event)} target="_blank" rel="noopener noreferrer"
                               class="group -m-2 block rounded-lg p-2 transition-colors hover:bg-gray-50 dark:hover:bg-white/[0.04] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
                                <p class="font-semibold text-brand-primary dark:text-white transition-colors group-hover:text-accent">{event.title}</p>
                                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
                                    {[eventDates(event), eventPlace(event)].filter(Boolean).join(" \u00b7 ")}
                                </p>
                            </a>
                        </li>
                    ))}
                </ul>
            ) : past.reachable ? (
                <p class="flex items-center justify-center py-10 text-sm text-gray-500 dark:text-gray-400">
                    <CalendarIcon className="mr-2 h-5 w-5" aria-hidden="true" />
                    No past training events to show.
                </p>
            ) : (
                <Unavailable href="https://tess.elixir-europe.org/events?country[]=Norway&include_expired=true" />
            )}
        </div>
    </section>

    <script>
        const filter = document.getElementById("material-filter") as HTMLInputElement | null;
        const list = document.getElementById("material-list");
        const empty = document.getElementById("material-empty");

        filter?.addEventListener("input", () => {
            const term = filter.value.trim().toLowerCase();
            let shown = 0;

            for (const item of list?.querySelectorAll<HTMLLIElement>("li[data-title]") ?? []) {
                const match = !term || (item.dataset.title ?? "").includes(term);
                item.hidden = !match;
                if (match) shown++;
            }
            if (empty) empty.hidden = shown > 0;
        });
    </script>


</Page>
