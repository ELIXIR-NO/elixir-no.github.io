---
import slugify from "slugify";

const { title, centered = true, marginTop } = Astro.props;
const headingSlug = slugify(title.toLowerCase());
---

<section class={`${marginTop ? "mt-16 lg:mt-20" : ""}`}>
    <div class="mx-auto max-w-6xl">
        <h2
            class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-ink scroll-mt-20"
            id={headingSlug}
        >
            {title}
        </h2>
        <div class={`mt-4 text-base sm:text-lg text-body leading-relaxed [&_p:first-child]:mt-0 ${centered ? "max-w-3xl" : ""}`}>
            <slot name="description" />
        </div>
    </div>
    <div class="mx-auto max-w-6xl mt-10 lg:mt-12">
        <slot />
    </div>
</section>
