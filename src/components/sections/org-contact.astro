---
import type { OrgContact, OrgLink } from '../../data/organizations';
import {
    ArrowTopRightOnSquareIcon,
    EnvelopeIcon,
    InformationCircleIcon,
    MapPinIcon,
} from '@heroicons/react/24/outline';

interface Props {
    contacts: OrgContact[];
    links: OrgLink[];
    callout?: string;
    lat: number;
    lng: number;
    address: string;
    color: string;
}

const { contacts, links, callout, lat, lng, address, color } = Astro.props;

const mapBaseUrl = 'https://www.openstreetmap.org/export/embed.html';
const offset = 0.005 / 14;
const mapSrc = `${mapBaseUrl}?bbox=${lng - offset},${lat - offset},${lng + offset},${lat + offset}&zoom=14&layer=mapnik&marker=${lat},${lng}`;
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;

const hasContactInfo = contacts.length > 0 || links.length > 0 || callout;
---

<section class="border-t border-gray-200/60 dark:border-gray-700/30 bg-gray-50/50 dark:bg-white/[0.02]">
    <div class="mx-auto max-w-7xl px-6 sm:px-8 py-16 sm:py-20">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-brand-primary dark:text-white">
            Get in Touch
        </h2>

        <div class={`mt-10 grid gap-10 ${hasContactInfo ? 'lg:grid-cols-2 lg:gap-16' : ''}`}>
            {hasContactInfo && (
                <div class="space-y-8">
                    {contacts.length > 0 && (
                        <div>
                            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-4">
                                Contact
                            </h3>
                            <div class="space-y-3">
                                {contacts.map((c) => (
                                    <a
                                        href={`mailto:${c.email}`}
                                        class="group flex items-start gap-4 p-4 rounded-xl bg-white dark:bg-white/[0.04] border border-gray-200/60 dark:border-gray-700/30 shadow-sm ring-1 ring-black/[0.03] dark:ring-white/[0.03] hover:border-accent/30 hover:shadow-md hover:shadow-accent/[0.06] transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                                    >
                                        <div class="shrink-0 mt-0.5 h-9 w-9 rounded-lg flex items-center justify-center bg-brand-primary/5 dark:bg-white/[0.06] group-hover:bg-accent/10 transition-colors">
                                            <EnvelopeIcon className="h-4 w-4 text-brand-primary dark:text-gray-300 group-hover:text-accent transition-colors" aria-hidden="true" />
                                        </div>
                                        <div class="min-w-0">
                                            <div class="text-sm font-semibold text-brand-primary dark:text-white">
                                                {c.reason}
                                            </div>
                                            <div class="text-sm text-accent mt-0.5 truncate">
                                                {c.label || c.email}
                                            </div>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}

                    {links.length > 0 && (
                        <div>
                            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-4">
                                Resources
                            </h3>
                            <div class="space-y-1">
                                {links.map((l) => (
                                    <a
                                        href={l.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="group flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white dark:hover:bg-white/[0.04] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                                    >
                                        <ArrowTopRightOnSquareIcon className="h-4 w-4 shrink-0 text-gray-500 dark:text-gray-400 group-hover:text-accent transition-colors" aria-hidden="true" />
                                        <span class="text-sm font-medium text-brand-grey dark:text-gray-300 group-hover:text-brand-primary dark:group-hover:text-white transition-colors">
                                            {l.text}
                                        </span>
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}

                    {callout && (
                        <div class="rounded-xl border-l-4 border-blue-400 dark:border-blue-500 bg-blue-50/50 dark:bg-blue-900/10 px-5 py-4">
                            <div class="flex items-start gap-3">
                                <InformationCircleIcon className="h-5 w-5 shrink-0 mt-0.5 text-blue-500 dark:text-blue-400" aria-hidden="true" />
                                <p class="text-sm text-blue-800 dark:text-blue-300 leading-relaxed">
                                    {callout}
                                </p>
                            </div>
                        </div>
                    )}
                </div>
            )}

            <div>
                <div class="rounded-2xl overflow-hidden shadow-lg ring-1 ring-black/[0.05] dark:ring-white/[0.05] h-72 lg:h-full lg:min-h-[320px]">
                    <iframe
                        width="100%"
                        height="100%"
                        src={mapSrc}
                        title={`Map showing ${address}`}
                        loading="lazy"
                        class="border-0"
                    />
                </div>
                <p class="mt-3 text-center">
                    <a
                        href={googleMapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400 hover:text-brand-primary dark:hover:text-white transition-colors"
                    >
                        <MapPinIcon className="h-3.5 w-3.5" aria-hidden="true" />
                        {address}
                    </a>
                </p>
            </div>
        </div>
    </div>
</section>
