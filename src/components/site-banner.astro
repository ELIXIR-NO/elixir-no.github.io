---
import { ArrowRightIcon, XMarkIcon } from "@heroicons/react/24/outline";
import { banner, bannerId, isLive, renderInlineMarkdown } from "../lib/banner";

if (!isLive(banner)) return;

const { label, message, link, expires } = banner;
const external = link?.href.startsWith("https://");
---

<div
    id="site-banner"
    role="region"
    aria-label="Announcement"
    data-banner-id={bannerId(banner)}
    data-expires={expires}
    data-pagefind-ignore
    class="sticky top-0 z-[60] border-b border-white/10 bg-brand-primary text-white banner-slide-down"
>
    <!-- Brand colours rather than theme tokens: the banner keeps the ELIXIR navy
         in both themes, since a light bar in dark mode reads as part of the page. -->
    <div class="flex w-full items-center gap-2 py-2 pl-4 pr-1.5 sm:py-2.5 sm:pl-6 sm:pr-3">
        <div class="flex min-w-0 flex-1 flex-wrap items-center justify-center gap-x-4 gap-y-1.5 text-center text-sm sm:text-base">
            {label && (
                <span class="inline-flex items-center rounded-chip bg-brand-secondary px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide text-brand-primary">
                    {label}
                </span>
            )}
            <p class="m-0 font-medium text-white" set:html={renderInlineMarkdown(message)} />
            {link && (
                <a
                    href={link.href}
                    target={external ? "_blank" : undefined}
                    rel={external ? "noopener noreferrer" : undefined}
                    class="inline-flex items-center gap-1.5 rounded-control bg-white px-3 py-1 text-sm font-semibold text-brand-primary no-underline transition-colors hover:bg-white/85 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-secondary focus-visible:ring-offset-2 focus-visible:ring-offset-brand-primary"
                >
                    {link.label}
                    <ArrowRightIcon className="h-4 w-4" aria-hidden="true" />
                </a>
            )}
        </div>
        <button
            type="button"
            class="-my-1.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-control text-white/75 transition-colors hover:bg-white/10 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60 sm:my-0 sm:h-9 sm:w-9"
            aria-label="Dismiss announcement"
        >
            <XMarkIcon className="h-5 w-5" aria-hidden="true" />
        </button>
    </div>
</div>

<style>
    @keyframes bannerSlideDown {
        from { transform: translateY(-100%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    .banner-slide-down { animation: bannerSlideDown 0.6s ease-out; }
    @media (prefers-reduced-motion: reduce) { .banner-slide-down { animation: none; } }
</style>

<script is:inline>
    (() => {
        const b = document.getElementById('site-banner');
        if (!b) return;
        const key = 'banner-dismissed';
        let dismissed = null;
        try { dismissed = sessionStorage.getItem(key); } catch {}
        // The build only knows whether the deadline had passed when the site was
        // last deployed, so each visit checks it again.
        if (Date.parse(b.dataset.expires || '') <= Date.now() || dismissed === b.dataset.bannerId) {
            b.remove();
            return;
        }
        // The fixed navigation sits below the banner, which stays pinned to the top while scrolling.
        const root = document.documentElement.style;
        const reserve = () => root.setProperty('--site-banner-height', `${b.offsetHeight}px`);
        reserve();
        const observer = new ResizeObserver(reserve);
        observer.observe(b);
        b.querySelector('button').addEventListener('click', () => {
            observer.disconnect();
            b.remove();
            root.removeProperty('--site-banner-height');
            try { sessionStorage.setItem(key, b.dataset.bannerId); } catch {}
        });
    })();
</script>
