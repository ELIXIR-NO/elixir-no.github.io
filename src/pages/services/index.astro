---
import { getCollection } from "astro:content";
import Page from "../../layouts/page.astro";
import ListingFilters from "../../components/listing-filters";
import ServiceStatusSummary from "../../components/service-status-summary";
import { slugToTitleCase, idToSlug, resolveContentAsset } from "../../lib/utils";
import { ArrowRightIcon } from "@heroicons/react/24/outline";

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const services = (await getCollection("services")).sort((a, b) => a.data.title.localeCompare(b.data.title));

const statusServices = services
    .filter(s => s.data.website)
    .map(s => ({ title: s.data.title, website: s.data.website!, slug: idToSlug(s.id) }));

// Build tag list with counts
const tagCounts = new Map<string, number>();
services.forEach(s => (s.data.tags ?? []).forEach(t => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)));
const tags = [...tagCounts.entries()]
    .sort((a, b) => b[1] - a[1])
    .map(([id, count]) => ({ id, label: slugToTitleCase(id), count }));

function monogram(title: string): string {
    const words = title.split(/\s+/).filter(Boolean);
    if (words.length > 1) return (words[0][0] + words[1][0]).toUpperCase();
    const capitals = title.match(/[A-Z]/g);
    if (capitals && capitals.length >= 2) return capitals.slice(0, 2).join('');
    return title.slice(0, 2).toUpperCase();
}

function domainOf(website?: string): string | null {
    if (!website) return null;
    try {
        return new URL(website).hostname.replace(/^www\./, '');
    } catch {
        return null;
    }
}
---

<Page variant="wide" seo={{
    title: "Services",
    description: "Bioinformatics tools and infrastructure for life science research — data management, analysis, storage, and compute services provided by ELIXIR Norway.",
}}>

    <!-- Hero -->
    <div class="max-w-3xl">
        <p class="flex items-center gap-2 text-sm font-semibold text-marker-text tracking-wide uppercase"><span class="h-2 w-2 rounded-marker bg-marker" aria-hidden="true" />Services</p>
        <h1 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-ink leading-[1.1]">
            Tools and infrastructure for life science research
        </h1>
        <p class="mt-6 text-base sm:text-lg leading-relaxed text-body max-w-2xl">
            ELIXIR Norway provides software tools, databases, storage and compute infrastructure
            to support life science researchers across Norway and internationally.
        </p>
        <ServiceStatusSummary client:idle services={statusServices} href={`${BASE}/services/status`} />
    </div>

    <!-- Filter -->
    <div class="mt-12">
        <ListingFilters client:load groups={[{ key: 'tags', label: 'Tags', options: tags, mode: 'multi' }]} event="tags-changed" />
    </div>

    <!-- Service grid -->
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="services-grid" aria-live="polite">
        {services.map((service) => {
            const slug = idToSlug(service.id);
            const logo = service.data.logo ? resolveContentAsset(`${service.collection}/${service.id}`, service.data.logo) : null;
            const serviceTags = service.data.tags ?? [];
            const isNodeService = serviceTags.includes('service');
            const domain = domainOf(service.data.website);
            return (
                <a
                    href={`${BASE}/services/${slug}`}
                    class="service-card group relative flex flex-col rounded-card border border-rule bg-surface overflow-hidden transition-colors duration-200 hover:border-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
                    data-tags={serviceTags.join(',')}
                >
                    {/* White in both modes: many logos ship with a baked-in white background. */}
                    <div class="relative grid place-items-center h-32 bg-white border-b border-rule">
                        {isNodeService && (
                            <span class="absolute top-2.5 right-2.5 inline-flex items-center gap-1.5 rounded-chip border border-brand-primary/20 bg-white px-2 py-0.5 text-xs font-semibold text-brand-primary before:h-1.5 before:w-1.5 before:rounded-marker before:bg-brand-secondary before:content-['']">
                                Node service
                            </span>
                        )}
                        {logo && (
                            <img
                                src={logo}
                                alt=""
                                aria-hidden="true"
                                class="max-h-16 max-w-[66%] object-contain"
                                loading="lazy"
                                onerror="this.nextElementSibling.classList.remove('hidden'); this.remove()"
                            />
                        )}
                        <span
                            class:list={["inline-flex items-center gap-3 font-display text-4xl font-bold tracking-tight text-brand-primary before:h-2.5 before:w-2.5 before:rounded-marker before:bg-brand-secondary before:content-['']", { hidden: logo }]}
                            aria-hidden="true"
                        >
                            {monogram(service.data.title)}
                        </span>
                    </div>

                    <div class="flex flex-col flex-1 px-5 pt-[18px] pb-4">
                        <h2 class="text-lg font-semibold text-ink leading-snug decoration-marker decoration-2 underline-offset-4 group-hover:underline">
                            {service.data.title}
                        </h2>

                        <p class="mt-2 text-sm leading-relaxed text-body line-clamp-2 flex-1">
                            {service.data.summary}
                        </p>

                        {serviceTags.length > 0 && (
                            <div class="mt-3.5 flex flex-wrap gap-1.5">
                                {serviceTags.filter(t => t !== 'service').slice(0, 3).map(tag => (
                                    <span class="rounded-chip border border-rule px-2 py-0.5 text-xs font-medium text-muted">
                                        {slugToTitleCase(tag)}
                                    </span>
                                ))}
                            </div>
                        )}

                        <div class="mt-4 pt-3 border-t border-rule flex items-center justify-between gap-3">
                            <span class="flex shrink-0 items-center gap-1.5 whitespace-nowrap text-[13px] font-semibold text-ink">
                                Learn more
                                <ArrowRightIcon className="h-3 w-3 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
                            </span>
                            {domain && (
                                <span class="min-w-0 truncate font-mono text-xs text-muted">
                                    {domain}
                                </span>
                            )}
                        </div>
                    </div>
                </a>
            );
        })}
    </div>

    <!-- Filtering script -->
    <script is:inline>
        window.addEventListener('tags-changed', function(e) {
            var detail = e.detail || {};
            var tagsSet = detail['tags'];
            var noTags = !tagsSet || tagsSet.size === 0;
            document.querySelectorAll('.service-card').forEach(function(card) {
                if (noTags) { card.style.display = ''; return; }
                var cardTags = (card.getAttribute('data-tags') || '').split(',');
                var match = false;
                tagsSet.forEach(function(t) { if (cardTags.indexOf(t) !== -1) match = true; });
                card.style.display = match ? '' : 'none';
            });
        });
    </script>

</Page>
