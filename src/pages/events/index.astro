---
import Page from "../../layouts/page.astro";
import { getCollection } from "astro:content";
import { idToSlug, resolveContentAsset } from "../../lib/utils";
import { ArrowRightIcon, CalendarIcon, NewspaperIcon } from "@heroicons/react/24/outline";

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');

function parseDate(dateString: string): number {
    const parsed = new Date(Date.parse(dateString));
    return isNaN(parsed.getTime()) ? 0 : parsed.getTime();
}

const now = Date.now();
const events = await getCollection("events");
events.sort((a, b) => parseDate(b.data.date) - parseDate(a.data.date));

const eventNewsSlugs = new Set([
    "2025/ahm-europe",
    "2025/eosc-entrust-workshop",
]);
const relatedNews = (await getCollection("news"))
    .filter((entry) => eventNewsSlugs.has(idToSlug(entry.id)))
    .sort((a, b) => parseDate(b.data.date) - parseDate(a.data.date));

const upcoming = events.filter(e => parseDate(e.data.date) >= now);
const past = events.filter(e => parseDate(e.data.date) < now);

function formatDate(dateString: string): string {
    const d = new Date(Date.parse(dateString));
    if (isNaN(d.getTime())) return dateString;
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Page variant="wide" seo={{
    title: "Events",
    description: "Workshops, hackathons, conferences, and community events from ELIXIR Norway and the European bioinformatics network.",
}}>

    <!-- Hero -->
    <div class="max-w-3xl">
        <p class="text-sm font-semibold text-accent tracking-wide uppercase">Events</p>
        <h1 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-brand-primary dark:text-white leading-[1.15]">
            Workshops, seminars, and community gatherings
        </h1>
        <p class="mt-6 text-base sm:text-lg leading-relaxed text-brand-grey dark:text-gray-300 max-w-2xl">
            Join ELIXIR Norway at events across the country — from hands-on bioinformatics
            workshops to international conferences and public panel debates.
        </p>
    </div>

    <!-- Upcoming events -->
    {upcoming.length > 0 && (
        <section class="mt-16">
            <div class="flex items-center gap-3 mb-8">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-green-100 dark:bg-green-900/20 px-3 py-1 text-xs font-semibold text-green-700 dark:text-green-400">
                    <span class="h-1.5 w-1.5 rounded-full bg-green-500 dark:bg-green-400 animate-pulse" />
                    Upcoming
                </span>
                <h2 class="text-xl font-semibold text-brand-primary dark:text-white">Upcoming events</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                {upcoming.map((event) => {
                    const slug = idToSlug(event.id);
                    const cover = event.data?.cover?.source
                        ? resolveContentAsset(`${event.collection}/${event.id}`, event.data.cover.source)
                        : null;
                    return (
                        <a
                            href={`${BASE}/events/${slug}`}
                            class="group relative flex flex-col rounded-xl border border-green-200/60 dark:border-green-700/20 bg-white dark:bg-white/[0.03] overflow-hidden transition-[border-color,box-shadow] duration-200 hover:border-accent/40 hover:shadow-[0_0_0_3px_rgb(var(--color-accent)/0.08)] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                        >
                            {cover ? (
                                <div class="h-40 bg-gray-50 dark:bg-white/5 overflow-hidden">
                                    <img
                                        src={cover}
                                        alt={event.data.title}
                                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                                        loading="lazy"
                                    />
                                </div>
                            ) : (
                                <div class="h-40 bg-gradient-to-br from-brand-primary/5 to-brand-secondary/10 dark:from-brand-primary/10 dark:to-brand-secondary/5 flex items-center justify-center">
                                    <CalendarIcon className="h-10 w-10 text-brand-secondary/30" aria-hidden="true" />
                                </div>
                            )}
                            <div class="flex flex-col flex-1 p-5">
                                <time class="text-xs font-medium text-accent">
                                    {formatDate(event.data.date)}
                                </time>
                                <h3 class="mt-2 text-base font-semibold text-brand-primary dark:text-white group-hover:text-accent transition-colors line-clamp-2">
                                    {event.data.title}
                                </h3>
                                <p class="mt-2 text-sm leading-relaxed text-brand-grey dark:text-gray-400 line-clamp-3 flex-1">
                                    {event.data.summary}
                                </p>
                                <div class="mt-4 flex items-center gap-1 text-xs font-medium text-gray-500 dark:text-gray-400 group-hover:text-accent transition-colors">
                                    View details
                                    <ArrowRightIcon className="h-3 w-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                                </div>
                            </div>
                        </a>
                    );
                })}
            </div>
        </section>
    )}

    <!-- Past events -->
    {past.length > 0 && (
        <section class={upcoming.length > 0 ? "mt-16" : "mt-12"}>
            <h2 class="text-xl font-semibold text-brand-primary dark:text-white mb-8">Past events</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                {past.map((event) => {
                    const slug = idToSlug(event.id);
                    const cover = event.data?.cover?.source
                        ? resolveContentAsset(`${event.collection}/${event.id}`, event.data.cover.source)
                        : null;
                    return (
                        <a
                            href={`${BASE}/events/${slug}`}
                            class="group relative flex flex-col rounded-xl border border-gray-200/60 dark:border-gray-700/30 bg-white dark:bg-white/[0.03] overflow-hidden transition-[border-color,box-shadow] duration-200 hover:border-accent/40 hover:shadow-[0_0_0_3px_rgb(var(--color-accent)/0.08)] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                        >
                            {cover ? (
                                <div class="h-40 bg-gray-50 dark:bg-white/5 overflow-hidden">
                                    <img
                                        src={cover}
                                        alt={event.data.title}
                                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                                        loading="lazy"
                                    />
                                </div>
                            ) : (
                                <div class="h-40 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-white/[0.02] dark:to-white/[0.05] flex items-center justify-center">
                                    <CalendarIcon className="h-10 w-10 text-gray-300 dark:text-gray-700" aria-hidden="true" />
                                </div>
                            )}
                            <div class="flex flex-col flex-1 p-5">
                                <time class="text-xs font-medium text-gray-500 dark:text-gray-400">
                                    {formatDate(event.data.date)}
                                </time>
                                <h3 class="mt-2 text-base font-semibold text-brand-primary dark:text-white group-hover:text-accent transition-colors line-clamp-2">
                                    {event.data.title}
                                </h3>
                                <p class="mt-2 text-sm leading-relaxed text-brand-grey dark:text-gray-400 line-clamp-3 flex-1">
                                    {event.data.summary}
                                </p>
                                <div class="mt-4 flex items-center gap-1 text-xs font-medium text-gray-500 dark:text-gray-400 group-hover:text-accent transition-colors">
                                    View details
                                    <ArrowRightIcon className="h-3 w-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                                </div>
                            </div>
                        </a>
                    );
                })}
            </div>
        </section>
    )}

    {relatedNews.length > 0 && (
        <section class={past.length > 0 || upcoming.length > 0 ? "mt-16" : "mt-12"}>
            <div class="max-w-3xl">
                <h2 class="text-xl font-semibold text-brand-primary dark:text-white">Event reports in the news archive</h2>
                <p class="mt-3 text-sm leading-relaxed text-brand-grey dark:text-gray-400">
                    Some past happenings are still best kept as news stories. We surface them here without changing their news format.
                </p>
            </div>
            <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-5">
                {relatedNews.map((entry) => {
                    const slug = idToSlug(entry.id);
                    const cover = entry.data?.cover?.source
                        ? resolveContentAsset(`${entry.collection}/${entry.id}`, entry.data.cover.source)
                        : null;
                    return (
                        <a
                            href={`${BASE}/news/${slug}`}
                            class="group flex flex-col rounded-xl border border-gray-200/60 dark:border-gray-700/30 bg-white dark:bg-white/[0.03] overflow-hidden transition-[border-color,box-shadow] duration-200 hover:border-accent/40 hover:shadow-[0_0_0_3px_rgb(var(--color-accent)/0.08)] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                        >
                            {cover ? (
                                <div class="h-40 bg-gray-50 dark:bg-white/5 overflow-hidden">
                                    <img
                                        src={cover}
                                        alt={entry.data.title}
                                        class="w-full h-full object-cover"
                                        loading="lazy"
                                    />
                                </div>
                            ) : (
                                <div class="h-40 bg-gradient-to-br from-brand-primary/5 to-brand-secondary/10 dark:from-brand-primary/10 dark:to-brand-secondary/5 flex items-center justify-center">
                                    <NewspaperIcon className="h-10 w-10 text-brand-secondary/20" aria-hidden="true" />
                                </div>
                            )}
                            <div class="flex flex-col flex-1 p-5">
                                <time class="text-xs font-medium text-gray-500 dark:text-gray-400">
                                    {formatDate(entry.data.date)}
                                </time>
                                <h3 class="mt-2 text-base font-semibold text-brand-primary dark:text-white group-hover:text-accent transition-colors line-clamp-2">
                                    {entry.data.title}
                                </h3>
                                <p class="mt-2 text-sm leading-relaxed text-brand-grey dark:text-gray-400 line-clamp-3 flex-1">
                                    {entry.data.summary}
                                </p>
                                <div class="mt-4 flex items-center gap-1 text-xs font-medium text-gray-500 dark:text-gray-400 group-hover:text-accent transition-colors">
                                    Read news article
                                    <ArrowRightIcon className="h-3 w-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                                </div>
                            </div>
                        </a>
                    );
                })}
            </div>
        </section>
    )}

    <!-- Empty state -->
    {events.length === 0 && relatedNews.length === 0 && (
        <div class="mt-16 text-center py-20">
            <CalendarIcon className="mx-auto h-12 w-12 text-brand-grey/20" aria-hidden="true" />
            <p class="mt-4 text-brand-grey dark:text-gray-400">No events scheduled at this time.</p>
        </div>
    )}

</Page>
