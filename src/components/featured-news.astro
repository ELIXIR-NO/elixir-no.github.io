---
import { getCollection } from "astro:content";
import { ArrowRightIcon } from "@heroicons/react/24/outline";
const news = (await getCollection("news"))
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
    .splice(0, 3);
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ul class="flex flex-col divide-y divide-rule border-t border-rule">
    {news.map((article) => {
        return (
                <li class="py-3">
                    <a href={`${BASE}/news/${article.id.replace(/\.mdx$/, "")}`} class="group block">
                        <span class="block font-display font-semibold text-ink decoration-marker decoration-2 underline-offset-4 group-hover:underline">{article.data.title}</span>
                        <time class="datetime block text-sm text-muted tabular-nums">{article.data.date}</time>
                    </a>
                </li>
        )
    })}
    <li class="py-3">
        <a href={`${BASE}/news`} class="link flex items-center">
            More news
            <ArrowRightIcon className="h-4 w-4 ml-1" aria-hidden="true" />
        </a>
    </li>
</ul>
