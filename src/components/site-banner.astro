---
import { ArrowRightIcon, XMarkIcon } from "@heroicons/react/24/outline";
import { banner, bannerId, isLive, renderInlineMarkdown } from "../lib/banner";

if (!isLive(banner)) return;

const { label, message, expires } = banner;

// On the page the banner points to, the link would only reload that page.
const withoutSlash = (path: string) => path.replace(/\/$/, "") || "/";
const link = banner.link && withoutSlash(banner.link.href) !== withoutSlash(Astro.url.pathname)
    ? banner.link
    : undefined;
const external = link?.href.startsWith("https://");
---

<div
    id="site-banner"
    role="region"
    aria-label="Announcement"
    data-banner-id={bannerId(banner)}
    data-expires={expires}
    data-pagefind-ignore
    class="sticky top-0 z-[60] border-b border-white/10 bg-brand-primary text-white banner-slide-down"
>
    <!-- Brand colours rather than theme tokens: the banner keeps the ELIXIR navy
         in both themes, since a light bar in dark mode reads as part of the page. -->
    <div class="flex w-full items-center gap-2 py-2 pl-4 pr-1.5 sm:pl-6 sm:pr-3 lg:py-2.5">
        <!-- Below lg the label, message and link run on as one piece of text, so the
             banner stays two lines on a phone; from lg they sit in a centred row. -->
        <div class="relative min-w-0 flex-1 text-balance text-sm leading-snug lg:flex lg:flex-wrap lg:items-center lg:justify-center lg:gap-x-4 lg:text-center lg:text-base lg:leading-normal">
            {label && (
                <span class="mr-1.5 inline-flex items-center rounded-chip bg-brand-secondary px-2 py-0.5 align-[0.1em] text-[0.6875rem] font-bold uppercase leading-4 tracking-wide text-brand-primary lg:mr-0 lg:px-2.5 lg:text-xs">
                    {label}
                </span>
            )}
            <p id="site-banner-message" class="m-0 inline font-medium text-white lg:block" set:html={renderInlineMarkdown(message)} />
            {link && (
                <!-- The name joins the link text with the message, so "Read more" has
                     a subject in a screen reader's list of links. The ::before is the
                     tap target: the whole text block below lg, and 44px tall around
                     the button from lg, without making the banner taller. -->
                <a
                    id="site-banner-link"
                    aria-labelledby="site-banner-link site-banner-message"
                    href={link.href}
                    target={external ? "_blank" : undefined}
                    rel={external ? "noopener noreferrer" : undefined}
                    class="ml-1.5 inline-flex items-center gap-1 whitespace-nowrap rounded-control align-baseline font-semibold text-white underline decoration-white/50 underline-offset-2 before:absolute before:inset-0 before:content-[''] focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-secondary focus-visible:ring-offset-2 focus-visible:ring-offset-brand-primary lg:relative lg:ml-0 lg:gap-1.5 lg:bg-white lg:px-3 lg:py-1 lg:text-sm lg:text-brand-primary lg:no-underline lg:transition-colors lg:before:-inset-y-2 lg:hover:bg-white/85"
                >
                    {/* On a phone the arrow alone marks the link, which keeps the banner to two lines. */}
                    <span class="max-sm:sr-only">{link.label}</span>
                    <ArrowRightIcon className="h-3.5 w-3.5 lg:h-4 lg:w-4" aria-hidden="true" />
                </a>
            )}
        </div>
        <button
            type="button"
            class="-my-1.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-control text-white/75 transition-colors hover:bg-white/10 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60 lg:my-0 lg:h-9 lg:w-9"
            aria-label="Dismiss announcement"
        >
            <XMarkIcon className="h-5 w-5" aria-hidden="true" />
        </button>
    </div>
</div>

<style>
    @keyframes bannerSlideDown {
        from { transform: translateY(-100%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    .banner-slide-down { animation: bannerSlideDown 0.6s ease-out; }
    @media (prefers-reduced-motion: reduce) { .banner-slide-down { animation: none; } }
</style>

<script is:inline>
    (() => {
        const b = document.getElementById('site-banner');
        if (!b) return;
        const key = 'banner-dismissed';
        let dismissed = null;
        try { dismissed = sessionStorage.getItem(key); } catch {}
        // The build only knows whether the deadline had passed when the site was
        // last deployed, so each visit checks it again.
        if (Date.parse(b.dataset.expires || '') <= Date.now() || dismissed === b.dataset.bannerId) {
            b.remove();
            return;
        }
        // The fixed navigation sits below the banner, which stays pinned to the top while scrolling.
        const root = document.documentElement.style;
        const reserve = () => root.setProperty('--site-banner-height', `${b.offsetHeight}px`);
        reserve();
        const observer = new ResizeObserver(reserve);
        observer.observe(b);
        b.querySelector('button').addEventListener('click', () => {
            observer.disconnect();
            b.remove();
            root.removeProperty('--site-banner-height');
            try { sessionStorage.setItem(key, b.dataset.bannerId); } catch {}
        });
    })();
</script>
