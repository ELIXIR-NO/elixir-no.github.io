---
import Page from "../../layouts/page.astro";
import { getCollection } from "astro:content";
import { idToSlug, resolveContentAsset } from "../../lib/utils";
import { ArrowRightIcon, CalendarIcon } from "@heroicons/react/24/outline";

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');

function parseDate(dateString: string): number {
    const parsed = new Date(Date.parse(dateString));
    return isNaN(parsed.getTime()) ? 0 : parsed.getTime();
}

const now = Date.now();
const events = await getCollection("events");
events.sort((a, b) => parseDate(b.data.date) - parseDate(a.data.date));

const upcoming = events.filter(e => parseDate(e.data.date) >= now);
const past = events.filter(e => parseDate(e.data.date) < now);

function formatDate(dateString: string): string {
    const d = new Date(Date.parse(dateString));
    if (isNaN(d.getTime())) return dateString;
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Page variant="wide" seo={{
    title: "Events",
    description: "Workshops, hackathons, conferences, and community events from ELIXIR Norway and the European bioinformatics network.",
}}>

    <!-- Hero -->
    <div class="max-w-3xl">
        <p class="flex items-center gap-2 text-sm font-semibold text-marker-text tracking-wide uppercase"><span class="h-2 w-2 rounded-marker bg-marker" aria-hidden="true" />Events</p>
        <h1 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-ink leading-[1.1]">
            Workshops, seminars, and community gatherings
        </h1>
        <p class="mt-6 text-base sm:text-lg leading-relaxed text-body max-w-2xl">
            Join ELIXIR Norway at events across the country — from hands-on bioinformatics
            workshops to international conferences and public panel debates.
        </p>
    </div>

    <!-- Upcoming events -->
    {upcoming.length > 0 && (
        <section class="mt-12">
            <div class="flex items-center gap-3 mb-8">
                <span class="inline-flex items-center gap-1.5 rounded-chip border border-rule px-2 py-0.5 text-xs font-semibold text-green-700 dark:text-green-400">
                    <span class="h-2 w-2 rounded-marker bg-green-600 dark:bg-green-400" />
                    Upcoming
                </span>
                <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-ink">Upcoming events</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                {upcoming.map((event) => {
                    const slug = idToSlug(event.id);
                    const cover = event.data?.cover?.source
                        ? resolveContentAsset(`${event.collection}/${event.id}`, event.data.cover.source)
                        : null;
                    return (
                        <a
                            href={`${BASE}/events/${slug}`}
                            class="group relative flex flex-col rounded-card border border-rule bg-surface overflow-hidden transition-colors hover:border-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                        >
                            {cover ? (
                                <div class="h-40 bg-paper border-b border-rule overflow-hidden">
                                    <img
                                        src={cover}
                                        alt={event.data.title}
                                        class="w-full h-full object-cover"
                                        loading="lazy"
                                    />
                                </div>
                            ) : (
                                <div class="h-40 bg-paper border-b border-rule flex items-center justify-center">
                                    <CalendarIcon className="h-10 w-10 text-rule" aria-hidden="true" />
                                </div>
                            )}
                            <div class="flex flex-col flex-1 p-5">
                                <time class="font-mono text-xs text-muted">
                                    {formatDate(event.data.date)}
                                </time>
                                <h3 class="mt-2 text-base font-semibold text-ink leading-snug decoration-marker decoration-2 underline-offset-4 group-hover:underline line-clamp-2">
                                    {event.data.title}
                                </h3>
                                <p class="mt-2 text-sm leading-relaxed text-body line-clamp-3 flex-1">
                                    {event.data.summary}
                                </p>
                                <div class="mt-4 flex items-center gap-1.5 text-sm font-semibold text-ink">
                                    View details
                                    <ArrowRightIcon className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                                </div>
                            </div>
                        </a>
                    );
                })}
            </div>
        </section>
    )}

    <!-- Past events -->
    {past.length > 0 && (
        <section class={upcoming.length > 0 ? "mt-16 lg:mt-20" : "mt-12"}>
            <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-ink mb-8">Past events</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                {past.map((event) => {
                    const slug = idToSlug(event.id);
                    const cover = event.data?.cover?.source
                        ? resolveContentAsset(`${event.collection}/${event.id}`, event.data.cover.source)
                        : null;
                    return (
                        <a
                            href={`${BASE}/events/${slug}`}
                            class="group relative flex flex-col rounded-card border border-rule bg-surface overflow-hidden transition-colors hover:border-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                        >
                            {cover ? (
                                <div class="h-40 bg-paper border-b border-rule overflow-hidden">
                                    <img
                                        src={cover}
                                        alt={event.data.title}
                                        class="w-full h-full object-cover"
                                        loading="lazy"
                                    />
                                </div>
                            ) : (
                                <div class="h-40 bg-paper border-b border-rule flex items-center justify-center">
                                    <CalendarIcon className="h-10 w-10 text-rule" aria-hidden="true" />
                                </div>
                            )}
                            <div class="flex flex-col flex-1 p-5">
                                <time class="font-mono text-xs text-muted">
                                    {formatDate(event.data.date)}
                                </time>
                                <h3 class="mt-2 text-base font-semibold text-ink leading-snug decoration-marker decoration-2 underline-offset-4 group-hover:underline line-clamp-2">
                                    {event.data.title}
                                </h3>
                                <p class="mt-2 text-sm leading-relaxed text-body line-clamp-3 flex-1">
                                    {event.data.summary}
                                </p>
                                <div class="mt-4 flex items-center gap-1.5 text-sm font-semibold text-ink">
                                    View details
                                    <ArrowRightIcon className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                                </div>
                            </div>
                        </a>
                    );
                })}
            </div>
        </section>
    )}

    <!-- Empty state -->
    {events.length === 0 && (
        <div class="mt-12 text-center py-16">
            <CalendarIcon className="mx-auto h-12 w-12 text-rule" aria-hidden="true" />
            <p class="mt-4 text-body">No events scheduled at this time.</p>
        </div>
    )}

</Page>
