---
import { ArrowRightIcon } from "@heroicons/react/24/outline";
import people from "../data/people.json";

type Org = {
    name: string;
    people: Person[];
}
type Person = {
    "name": string;
    "title": string;
    "photo": string;
    "profile-url": string;
    "affiliations": Array<{ name: string; role: string }>
    "elixir-groups": Array<{ name: string; role: string }>
}

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
    elixirGroup,
    org,
    hidePicture,
    layout = "default",
    hideOrg,
    isSummary = false
} = Astro.props;

function composeTitle(person: Person) {
    return [
        person.title,
        ...person["elixir-groups"].map(g => g.role).filter(Boolean),
        ...person["affiliations"].map(a => {
            if (a) return `${a?.role ? a.role + "—" : ''}${a.name}`;
        }),
    ]
        .filter(Boolean)
        .join(", ")
}

function getAllPeopleWithMetadata(data: { groups: any, orgs: { [key: string]: Org } }) {
    let allPeople = [];
    for (const [orgKey, org] of Object.entries(data.orgs)) {
        org.people.forEach(person => {
            const personWithMetadata = {
                ...person,
                "org-key": orgKey,
                "org-name": (org as Org).name,
                "full-title": composeTitle(person)
            };
            allPeople.push(personWithMetadata);
        });
    }
    return allPeople;
}

const sub = x => x?.name === elixirGroup;

const peopleWithMeta = getAllPeopleWithMetadata(people);

const filteredPeople = peopleWithMeta
    .filter(o => !org ? true : o["org-key"] === org)
    .filter(o => !elixirGroup ? true : o["elixir-groups"]?.find(sub));

const isFeatured = layout === "featured";

const gridClass = (() => {
    switch (layout) {
        case "featured": return "sm:grid-cols-2 lg:grid-cols-3 gap-4";
        case "three-col": return "sm:grid-cols-2 lg:grid-cols-3";
        case "two-col": return "sm:grid-cols-2";
        default: return "";
    }
})();

const groupLabels: Record<string, string> = {
    "node-leaders": "Node Leader",
    "coordinators": "Coordinator",
    "steering-board": "Steering Board",
    "scientific-advisory-committee": "Advisory Committee",
    "stakeholder-panel": "Stakeholder Panel",
};

function getElixirRole(person: any): string {
    if (!elixirGroup) return "";
    const match = person["elixir-groups"]?.find((g: any) => g.name === elixirGroup);
    return match?.role || groupLabels[elixirGroup] || "";
}
---

<Fragment>
    {isSummary ? (
        <a
            href={`${BASE}/about/everyone`}
            class="group block rounded-card border border-rule bg-surface p-8 sm:p-10 !no-underline transition-colors hover:border-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-accent mt-6"
        >
            <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-muted">
                <span class="h-2 w-2 rounded-marker bg-marker" aria-hidden="true" />
                Our team
            </p>
            <p class="mt-2 text-2xl sm:text-3xl font-semibold text-ink tracking-tight">
                70+ researchers, engineers & scientists
            </p>
            <p class="mt-2 text-sm text-body">
                Across five Norwegian universities
            </p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-ink">
                Meet the team
                <ArrowRightIcon className="h-4 w-4" aria-hidden="true" />
            </span>
        </a>
    ) : (
        <ul class={`grid ${isFeatured ? '' : 'gap-3'} ${gridClass}`} role="list">
            {filteredPeople.map((person) => {
                const role = getElixirRole(person);
                return (
                    <li>
                        {isFeatured ? (
                            <a
                                href={person["profile-url"]}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group flex flex-col items-start text-left rounded-card border border-rule bg-surface p-5 !no-underline transition-colors hover:border-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                            >
                                <div class="h-16 w-16 sm:h-20 sm:w-20 shrink-0 overflow-hidden rounded-full border border-rule">
                                    <img
                                        alt={person.name}
                                        src={`${BASE}${person.photo}`}
                                        class="h-full w-full object-cover"
                                        loading="lazy"
                                    />
                                </div>
                                <div class="mt-4 w-full">
                                    <div class="inline-block rounded-chip border border-rule px-2 py-0.5 text-xs font-medium text-muted">
                                        {role}
                                    </div>
                                    <div class="mt-2 text-sm sm:text-base font-semibold text-ink">
                                        {person.name}
                                    </div>
                                    <div class="mt-1 text-xs text-body leading-relaxed">
                                        {person.title}
                                    </div>
                                    <div class="mt-0.5 text-[11px] text-muted">
                                        {person["org-name"]}
                                    </div>
                                </div>
                            </a>
                        ) : (
                            <a
                                href={person["profile-url"]}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group grid grid-cols-[auto_1fr] items-center gap-3 rounded-card border border-rule bg-surface p-3 !no-underline transition-colors hover:border-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                            >
                                {!hidePicture && (
                                    <div class="h-11 w-11 shrink-0 overflow-hidden rounded-full border border-rule">
                                        <img
                                            alt={person.name}
                                            src={`${BASE}${person.photo}`}
                                            class="h-full w-full object-cover"
                                            loading="lazy"
                                        />
                                    </div>
                                )}
                                <div class="min-w-0">
                                    <div class="truncate text-sm font-semibold text-ink">
                                        {person.name}
                                    </div>
                                    <div class="truncate text-xs text-body mt-0.5">
                                        {person["full-title"]}
                                    </div>
                                    {!hideOrg && (
                                        <div class="truncate text-[11px] text-muted mt-0.5">
                                            {person["org-name"]}
                                        </div>
                                    )}
                                </div>
                            </a>
                        )}
                    </li>
                );
            })}
        </ul>
    )}
</Fragment>
