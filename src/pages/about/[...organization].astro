---
import { getCollection, render } from "astro:content";
import { components } from "../../components/elements";
import { idToSlug } from "../../lib/utils";
import { ORG_SLUGS } from "../../data/organizations";

export const prerender = true;

export async function getStaticPaths() {
    const allAbout = await getCollection("about");
    return allAbout
        .filter((entry) => {
            const slug = idToSlug(entry.id);
            // Exclude org slugs (handled by [org].astro) and the root
            // about/index.mdx (canonical /about lives in index.astro).
            return !ORG_SLUGS.has(slug) && slug !== "index";
        })
        .map((entry) => ({
            params: { organization: idToSlug(entry.id) },
            props: { entry },
        }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Content components={components} />
