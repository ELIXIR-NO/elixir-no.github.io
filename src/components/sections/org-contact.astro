---
import type { OrgContact, OrgLink } from '../../data/organizations';
import {
    ArrowTopRightOnSquareIcon,
    EnvelopeIcon,
    InformationCircleIcon,
    MapPinIcon,
} from '@heroicons/react/24/outline';

interface Props {
    contacts: OrgContact[];
    links: OrgLink[];
    callout?: string;
    lat: number;
    lng: number;
    address: string;
    color: string;
}

const { contacts, links, callout, lat, lng, address, color } = Astro.props;

const mapBaseUrl = 'https://www.openstreetmap.org/export/embed.html';
const offset = 0.005 / 14;
const mapSrc = `${mapBaseUrl}?bbox=${lng - offset},${lat - offset},${lng + offset},${lat + offset}&zoom=14&layer=mapnik&marker=${lat},${lng}`;
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;

const hasContactInfo = contacts.length > 0 || links.length > 0 || callout;
---

<section class="border-t border-rule bg-paper">
    <div class="mx-auto max-w-7xl px-6 sm:px-8 py-16 lg:py-20">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-ink">
            Get in Touch
        </h2>

        <div class={`mt-8 grid gap-10 ${hasContactInfo ? 'lg:grid-cols-2 lg:gap-16' : ''}`}>
            {hasContactInfo && (
                <div class="space-y-8">
                    {contacts.length > 0 && (
                        <div>
                            <h3 class="text-xs font-semibold uppercase tracking-wider text-muted mb-4">
                                Contact
                            </h3>
                            <div class="space-y-3">
                                {contacts.map((c) => (
                                    <a
                                        href={`mailto:${c.email}`}
                                        class="group flex items-start gap-4 p-4 rounded-card bg-surface border border-rule hover:border-ink transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                                    >
                                        <div class="shrink-0 mt-0.5 h-9 w-9 rounded-control flex items-center justify-center border border-rule">
                                            <EnvelopeIcon className="h-5 w-5 text-ink" aria-hidden="true" />
                                        </div>
                                        <div class="min-w-0">
                                            <div class="text-sm font-semibold text-ink">
                                                {c.reason}
                                            </div>
                                            <div class="text-sm text-accent mt-0.5 truncate">
                                                {c.label || c.email}
                                            </div>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}

                    {links.length > 0 && (
                        <div>
                            <h3 class="text-xs font-semibold uppercase tracking-wider text-muted mb-4">
                                Resources
                            </h3>
                            <div class="space-y-1">
                                {links.map((l) => (
                                    <a
                                        href={l.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="group flex items-center gap-3 px-4 py-3 rounded-control transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                                    >
                                        <ArrowTopRightOnSquareIcon className="h-4 w-4 shrink-0 text-muted group-hover:text-ink transition-colors" aria-hidden="true" />
                                        <span class="text-sm font-medium text-body group-hover:text-ink group-hover:underline decoration-marker decoration-2 underline-offset-4 transition-colors">
                                            {l.text}
                                        </span>
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}

                    {callout && (
                        <div class="rounded-card border border-rule bg-surface p-5">
                            <div class="flex items-start gap-3">
                                <InformationCircleIcon className="h-5 w-5 shrink-0 mt-0.5 text-blue-600 dark:text-blue-400" aria-hidden="true" />
                                <p class="text-sm text-body leading-relaxed">
                                    {callout}
                                </p>
                            </div>
                        </div>
                    )}
                </div>
            )}

            <div>
                <div class="rounded-card overflow-hidden border border-rule h-72 lg:h-full lg:min-h-[320px]">
                    <iframe
                        width="100%"
                        height="100%"
                        src={mapSrc}
                        title={`Map showing ${address}`}
                        loading="lazy"
                        class="border-0"
                    />
                </div>
                <p class="mt-3">
                    <a
                        href={googleMapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-ink transition-colors"
                    >
                        <MapPinIcon className="h-3.5 w-3.5" aria-hidden="true" />
                        {address}
                    </a>
                </p>
            </div>
        </div>
    </div>
</section>
